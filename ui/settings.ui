   <property name="styleSheet">
    <string notr="true">QWidget[objectName=&quot;centralwidget&quot;] {
background-color:#808080;
}

QScrollArea,QWidget[class=&quot;sidebarScroll&quot;] {
background-color:black;
}

QPushButton[class=&quot;sidebarBtn&quot;] {
background-color: grey;
border-radius: 5px;
padding: 2px;
color:black;
font-size: 15pt;
font-weight: bold;
height: 30px;
}

QPushButton[class2=&quot;sidebarBtnFocus&quot;] {
background-color: rgb(171, 179, 187);
}
QLabel[class=&quot;savedSettingsLabel&quot;] {
color: rgb(0, 195, 0);
font-weight:bold;
}
QWidget[class=&quot;frameHolder&quot;] {
background-color: #777B7E;
}
QFrame[class=&quot;frameHolder&quot;] {
border-radius: 10px;
border: 1px solid black;
qproperty-focusPolicy: &quot;NoFocus&quot;;
}

QPushButton[class=&quot;changeButton&quot;] {
background-color: #A9A9A9;
font-size:20pt;
border-radius: 10px;
}
QPushButton[class2=&quot;changeButtonIcon&quot;] {
min-height:25px;
min-width: 30px;
max-height:25px;
max-width: 30px;
}
QPushButton[class=&quot;lockBtn&quot;] {
border-image: url(:/img/img/lock.png);
background-color: none;
}
QPushButton[class=&quot;unlockBtn&quot;] {
border-image: url(:/img/img/unlock.png);
background-color: none;
}
QLineEdit[class=&quot;settingLineEdit&quot;]:disabled {
background-color:#555555;
color: rgb(201, 201, 201);
}

QLineEdit[class=&quot;settingLineEdit&quot;] {
background-color:white;
color: black;
font-size: 14pt;
}

QLabel[class=&quot;titleLabel&quot;] {
font-size:16pt;
font-weight:bold;
background-color: none;
color: black;
}

QLabel[class=&quot;infoLabel&quot;] {
